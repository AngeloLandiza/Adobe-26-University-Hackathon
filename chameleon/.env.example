# Copy this file to `.env` (same folder) and fill in your keys.
# `.env` is gitignored and excluded from the Docker build context. Never commit it.
# Real environment variables override values set here.

# Keys for the priority node's LLM ranker. Leave blank to use the built-in heuristic.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# auto (default) | claude | gemini | heuristic
CHAMELEON_LLM=auto

# Which model each provider calls (a model name, not an API key). The engine and
# dev.bench_priority both read these; delete a line to use the built-in default.
CHAMELEON_CLAUDE_MODEL=claude-opus-5-5
CHAMELEON_GEMINI_MODEL=gemini-3.8-flash

# Optional: cache LLM answers between dev runs (a directory, e.g. .cache/llm)
# CHAMELEON_LLM_CACHE=.cache/llm
