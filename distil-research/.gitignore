# Regenerable, large or raw output: keep out of git (see each folder's README).
# These folders end in ".nosync" so iCloud Drive (the repo lives in ~/Documents)
# doesn't sync thousands of PNG writes and create "name 2.png" conflict copies.
*.nosync/
training-data/judgments/pilot/sheets/
# challenge2 judgements quote real Crello ad text (licence unverified): local only
training-data/ab/*chl2*/judgments*.jsonl
# challenge3 (second real-ad evaluation set) judgements quote Crello ad text too: local only
training-data/ab/*chl3*/judgments*.jsonl
# raw distillation generations (regenerable; the merged train_v2.jsonl is committed)
training-data/llm-distill/gen_*.jsonl
training-data/llm-distill/qc.nosync/
